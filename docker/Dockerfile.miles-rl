# Thin layer on radixark/miles's own published image, adding rl/reward.py's
# extra deps (mirrors pyproject.toml's [dependency-groups].rl). Avoids the
# glibc <2.39 issue with `make rl-venv` — see Makefile / rl-docker-build.
ARG MILES_IMAGE=radixark/miles:latest
FROM ${MILES_IMAGE}

RUN pip install sentence-transformers>=5.7.0 einops>=0.8.2 loguru>=0.7.3
